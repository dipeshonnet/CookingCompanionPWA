rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /sharedRecipes/{recipeId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'sourceRecipeId', 'recipe'])
        && request.resource.data.authorId == request.auth.uid
        && (!exists(/databases/$(database)/documents/sharedRecipes/$(recipeId)) || resource.data.authorId == request.auth.uid)
        && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 100
        && request.resource.data.sourceRecipeId is string
        && request.resource.data.recipe is map
        && request.resource.data.recipe.id == recipeId
        && request.resource.data.recipe.authorId == request.auth.uid
        && request.resource.data.recipe.authorName == request.resource.data.authorName
        && request.resource.data.recipe.title is string && request.resource.data.recipe.title.size() <= 200
        && request.resource.data.recipe.ingredients is list && request.resource.data.recipe.ingredients.size() <= 500
        && request.resource.data.recipe.steps is list && request.resource.data.recipe.steps.size() <= 2000;
      match /ratings/{uid} {
        allow read: if request.auth != null;
        allow create, update: if owner(uid)
          && exists(/databases/$(database)/documents/sharedRecipes/$(recipeId))
          && request.resource.data.keys().hasOnly(['score'])
          && request.resource.data.score in [1, 3, 5];
      }
    }
    match /users/{uid}/app/{document} {
      allow read: if owner(uid) && document in ['profile', 'pantry', 'schedule', 'recipes', 'state', 'cooking'];
      allow delete: if owner(uid) && document == 'cooking';
      allow create, update: if owner(uid) && document == 'cooking'
        && request.resource.data.keys().hasOnly(['activeTimers', 'playSession'])
        && request.resource.data.activeTimers is list
        && (request.resource.data.playSession == null || request.resource.data.playSession is map);
      allow create, update: if owner(uid) && document == 'profile'
        && request.resource.data.keys().hasOnly(['schemaVersion', 'user'])
        && request.resource.data.schemaVersion == 2 && request.resource.data.user is map;
    }
    match /users/{uid}/pantry/{ingredient} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && request.resource.data.id is string
        && request.resource.data.name is string && request.resource.data.name.size() <= 200
        && request.resource.data.quantity is number && request.resource.data.quantity > 0
        && request.resource.data.unit is string && request.resource.data.category is string;
    }
    match /users/{uid}/recipes/{recipe} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && request.resource.data.id is string
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.ingredients is list && request.resource.data.ingredients.size() <= 500
        && request.resource.data.steps is list && request.resource.data.steps.size() <= 2000;
    }
    match /users/{uid}/meals/{slot} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['recipeId', 'portions'])
        && request.resource.data.recipeId is string
        && (!('portions' in request.resource.data)
          || (request.resource.data.portions is int && request.resource.data.portions >= 1));
    }
  }
}
